# Copy to .env and fill in keys (never commit .env)

# ==================== LLM PROVIDERS ====================
# Provider routing for the vendor-neutral core/llm stack (Phase 1+).
# Supported today: gemini | groq (qwen/Alibaba Cloud can be added later).
PRIMARY_LLM=gemini
FALLBACK_LLM=groq

# Gemini (Google AI Studio) — lite flash is the low-latency workhorse;
# 3.x "flash" (non-lite) models are thinking models and can take 30s+.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Groq (Groq Cloud — general chat: openai/gpt-oss-120b; Qwen also available)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Alibaba Cloud Model Studio / DashScope (Qwen) — OPTIONAL and NOT WIRED.
# The code currently routes only gemini | groq; there is no DashScope
# provider yet, so these are documentation only and are ignored at runtime.
# Get a key from https://dashscope.console.aliyun.com/ ; the OpenAI-compatible
# base URL is https://dashscope.aliyuncs.com/compatible-mode/v1 and a typical
# model id is "qwen-plus". Wire a provider in core/llm before relying on these.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=

# Legacy single-provider selector used by the old core/llm_client.py.
# Kept for backwards compatibility; PRIMARY_LLM above takes precedence.
AI_PROVIDER=gemini

# ==================== API SERVER ====================
API_HOST=0.0.0.0
API_PORT=8000

# ==================== FIRESTORE (REAL PERSISTENCE) ====================
# Firebase service account JSON - obtain from Firebase Console
# Get from: Firebase Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key":"YOUR_PRIVATE_KEY","client_email":"YOUR_SERVICE_ACCOUNT_EMAIL"}

# ==================== TWILIO SMS (REAL NOTIFICATIONS) ====================
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890

# ==================== SENDGRID EMAIL (REAL NOTIFICATIONS) ====================
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@tadbeerai.com

# ==================== NOTIFICATION RECIPIENTS ====================
# Default recipients (can be overridden per action in core/notification_templates.py)
STAKEHOLDER_PHONE=+923001234567
STAKEHOLDER_EMAIL=stakeholder@company.pk

# ==================== EXTERNAL BUSINESS APIs (STUBS) ====================
# Fill in with your actual API endpoints for real integration
BILLING_API_URL=http://billing.internal/api
BILLING_API_KEY=

INVENTORY_API_URL=http://inventory.internal/api
INVENTORY_API_KEY=

ANALYTICS_API_URL=http://analytics.internal/api
ANALYTICS_API_KEY=

# ==================== ECONOMIC DATA (PHASE 3A) ====================
# Live Pakistan economic indicators for the Economic Intelligence agent.
#
# The public World Bank API (api.worldbank.org) needs NO key and is used
# automatically for: CPI inflation, USD/PKR (annual average), FX reserves,
# remittances and GDP growth. Each series is fetched as an annual date-range,
# so the app receives a real ~11-point history (for charts), the previous
# year's value and the year-on-year change — not a single spot number.
#
# Optional: override the World Bank base URL (defaults to the official API;
# only set this to point at a mirror/proxy).
WORLD_BANK_BASE_URL=
#
# SBP/PBS: no official public JSON API exists today (SBP EasyData is an
# APEX HTML portal; PBS publishes HTML/PDF). Point SBP_BASE_URL /
# PBS_BASE_URL at your own gateway serving the JSON contract documented
# in core/economic_data/sbp_client.py and pbs_client.py. Leave empty to
# disable (those indicators then fall back to the labelled demo snapshot).
SBP_BASE_URL=
SBP_API_KEY=

PBS_BASE_URL=
PBS_API_KEY=

# Per-request HTTP timeout for all economic data calls (seconds).
ECONOMIC_DATA_TIMEOUT_SECONDS=10

# In-process snapshot cache lifetime (seconds).
ECONOMIC_DATA_CACHE_SECONDS=600

# false = never fall back to demo values: indicators without live data are
# reported as unavailable instead (no value, no source).
ECONOMIC_DATA_ALLOW_DEMO=true

# ==================== SCHEDULING & CONFIG ====================
APP_ENV=development
POLL_INTERVAL_MINUTES=15
MAX_FEED_ITEMS=20

# Optional: override JSON cache directory (default ./data; on Vercel uses /tmp/tadbeerai_data)
# DATA_DIR=/tmp/tadbeerai_data

